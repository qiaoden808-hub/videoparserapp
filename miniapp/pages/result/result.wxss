/* 结果页样式 */
.container {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 封面 */
.cover {
  border-radius: 24rpx;
  overflow: hidden;
}
.cover-img {
  width: 100%;
  display: block;
}

/* 信息卡片 */
.info-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #e2e8f0;
  line-height: 1.5;
}
.meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.author {
  font-size: 26rpx;
  color: #94a3b8;
}
.badge {
  padding: 4rpx 18rpx;
  background: rgba(59, 130, 246, 0.15);
  border-radius: 40rpx;
  font-size: 22rpx;
  color: #60a5fa;
}

/* 互动数据 */
.stats {
  display: flex;
  margin-top: 20rpx;
  padding: 20rpx 0;
  background: rgba(15, 23, 42, 0.5);
  border-radius: 16rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #e2e8f0;
}
.stat-label {
  font-size: 20rpx;
  color: #64748b;
}

/* 分区标题 */
.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e2e8f0;
  margin-bottom: 4rpx;
}
.section-hint {
  font-size: 22rpx;
  color: #64748b;
}

/* 画质选择 */
.quality-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0;
}
.quality-item {
  padding: 12rpx 28rpx;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid #334155;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #94a3b8;
  transition: all 0.2s;
}
.quality-item.active {
  background: rgba(59, 130, 246, 0.2);
  border-color: #3b82f6;
  color: #93c5fd;
}

.save-btn {
  margin-top: 16rpx;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}
.image-item {
  width: calc(33.33% - 8rpx);
  border-radius: 12rpx;
  overflow: hidden;
}
.grid-img {
  width: 100%;
  height: 200rpx;
  display: block;
}

.desc-text {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.7;
}

/* 底部操作 */
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.copy-btn,
.back-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 26rpx;
  background: rgba(30, 41, 59, 0.5);
  border: 1rpx solid #334155;
  color: #94a3b8;
}
.copy-btn:active,
.back-btn:active {
  opacity: 0.7;
}

.safe-area {
  height: env(safe-area-inset-bottom, 32rpx);
}
